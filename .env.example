# Copy to .env (never commit .env). Only the alerter container / alert publisher reads these.
# Leave unused channels empty.

# Slack incoming webhook
SCRIPTDRIFT_SLACK_WEBHOOK=

# Generic webhook and optional HMAC signing secret
SCRIPTDRIFT_WEBHOOK_URL=
SCRIPTDRIFT_WEBHOOK_SECRET=

# GitHub Issues (token needs issues:write on the repository)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# E-mail (SMTP)
SCRIPTDRIFT_SMTP_HOST=
SCRIPTDRIFT_SMTP_PORT=587
SCRIPTDRIFT_SMTP_USER=
SCRIPTDRIFT_SMTP_PASS=
SCRIPTDRIFT_SMTP_FROM=
SCRIPTDRIFT_SMTP_TO=

# Optional link to published reports shown in alerts
SCRIPTDRIFT_REPORT_URL=
