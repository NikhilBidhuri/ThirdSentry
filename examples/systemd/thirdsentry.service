# /etc/systemd/system/thirdsentry.service
# One-shot scan using the container pipeline. Triggered by thirdsentry.timer.
[Unit]
Description=ThirdSentry third-party JavaScript scan
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=thirdsentry
Group=docker
WorkingDirectory=/opt/thirdsentry
ExecStart=/opt/thirdsentry/scripts/run-scan.sh
# Exit codes 1 (findings) and 3 (incomplete scan) are expected outcomes, not service failures.
SuccessExitStatus=1 3
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/thirdsentry
